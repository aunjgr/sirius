[submodule "substrait"]
path = substrait
url = https://github.com/matrixorigin/duckdb-substrait-extension.git
branch = duckdb-1.5.5
[submodule "cucascade"]
path = cucascade
url = https://github.com/NVIDIA/cuCascade.git
branch = main
[submodule "duckdb-python"]
path = duckdb-python
url = https://github.com/duckdb/duckdb-python.git
[submodule ".claude/claude-tools"]
path = .claude/claude-tools
url = https://github.com/sirius-db/claude-tools.git
branch = main
[submodule "vcpkg"]
path = vcpkg
url = https://github.com/Microsoft/vcpkg.git
